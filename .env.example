# Supabase static storefront export
# Copy this file to .env locally, or set these variables in Plesk / your deploy shell.
# Do not commit your real keys.

SUPABASE_REST_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-public-anon-key

# Better for server-side export when available:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

STATIC_DATA_DIR=static-data
